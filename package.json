{
  "name": "bamdude-landing",
  "version": "1.0.0",
  "description": "Marketing landing for BamDude — self-hosted print management for Bambu Lab 3D printers",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
