---
import '../styles/globals.css';
import type { Locale } from '../i18n';
import { altLocale, defaultLocale, localePath } from '../i18n';
import { CookieBanner } from '../components/islands/CookieBanner';
import featuresEn from '../content/en/features-grouped.json';
import featuresUk from '../content/uk/features-grouped.json';
import { t } from '../i18n';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  ogImage?: string;
  ogType?: 'website' | 'article';
  // Optional ISO timestamp for article-type pages. Omit on website-type.
  ogUpdatedTime?: string;
  // Page slug used to pick a per-page OG image. Defaults to 'home' which
  // maps back to /og/<locale>/home.png. New value-prop pages (why, features,
  // install, faq, compare) get their own card.
  pageKey?: 'home' | 'why' | 'features' | 'install' | 'faq' | 'compare';
  // Breadcrumb trail rendered as JSON-LD only (not visible).
  // First entry is the root. Last entry is the current page.
  breadcrumbs?: { name: string; href: string }[];
}

const {
  title,
  description,
  locale,
  pageKey = 'home',
  ogImage = `/og/${locale}/${pageKey}.png`,
  ogType = 'website',
  ogUpdatedTime,
  breadcrumbs,
} = Astro.props;
const i = t(locale);
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://bamdude.top';
const path = Astro.url.pathname;
const canonical = `${siteUrl}${path}`;
const alt = altLocale(locale);
// EN-equivalent of the current path drives both the alt-locale link and
// x-default. For locale==='en' it's the path itself; for any other locale
// strip the leading /<locale>.
const enPath = locale === defaultLocale ? path : path.replace(new RegExp(`^/${locale}`), '') || '/';
const altPath = locale === defaultLocale ? `/${alt}${path === '/' ? '/' : path}` : enPath;
// x-default tells Google which page to serve when no language matches.
// We use the EN path for the same content (NOT the homepage), so /uk/why
// falls back to /why instead of /.
const xDefaultUrl = `${siteUrl}${enPath}`;

// --- Search metadata ------------------------------------------------------
// One JSON-LD graph per page, every entity carrying a stable `@id` so Google
// merges the Organization / WebSite / SoftwareApplication seen on twelve
// pages (and on docs.bamdude.top, which reuses the same ids) into one
// record instead of twelve. Only facts the code can vouch for go in: no
// ratings, no version numbers, no profiles that do not exist yet — invented
// structured data is a manual-action offence, an omitted field is nothing.
const repo = import.meta.env.PUBLIC_GITHUB_REPO || 'https://github.com/kainpl/bamdude';
const docsUrl = 'https://docs.bamdude.top';
const dockerHub = 'https://hub.docker.com/r/kainpl/bamdude';
const ogImageUrl = `${siteUrl}${ogImage}`;
// The card itself prints the hero slogan (pages/og), so that is what it shows.
const ogImageAlt = `BamDude - ${i.hero.title}`;
const orgId = `${siteUrl}/#organization`;
const websiteId = `${siteUrl}/#website`;
const softwareId = `${siteUrl}/#software`;
const breadcrumbId = `${canonical}#breadcrumb`;
const hasBreadcrumbs = !!breadcrumbs && breadcrumbs.length > 1;
// The feature groups of the features page, in the page's language.
const featureList = (locale === 'uk' ? featuresUk : featuresEn).groups.map((g) => g.title);
const organization = {
  '@type': 'Organization',
  '@id': orgId,
  name: 'BamDude',
  url: `${siteUrl}/`,
  logo: { '@type': 'ImageObject', url: `${siteUrl}/android-chrome-512x512.png`, width: 512, height: 512 },
  sameAs: [repo, dockerHub],
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organization,
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: 'BamDude',
      url: `${siteUrl}/`,
      inLanguage: ['en', 'uk'],
      publisher: { '@id': orgId },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': softwareId,
      name: 'BamDude',
      description: i.pages.home.description,
      url: `${siteUrl}/`,
      applicationCategory: 'BusinessApplication',
      applicationSubCategory: '3D print farm management',
      operatingSystem: 'Linux, Windows, macOS, Docker',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      license: 'https://www.gnu.org/licenses/agpl-3.0.html',
      featureList,
      screenshot: { '@type': 'ImageObject', url: `${siteUrl}/images/screenshot-desktop.png`, width: 1600, height: 1000 },
      image: `${siteUrl}/images/screenshot-desktop.png`,
      downloadUrl: `${repo}/releases`,
      installUrl: `${siteUrl}${localePath(locale, 'install')}`,
      softwareHelp: { '@type': 'CreativeWork', url: `${docsUrl}/` },
      sameAs: [repo, dockerHub],
      author: { '@id': orgId },
      publisher: { '@id': orgId },
      inLanguage: locale,
    },
    {
      '@type': 'WebPage',
      '@id': canonical,
      url: canonical,
      name: title,
      description,
      inLanguage: locale,
      isPartOf: { '@id': websiteId },
      about: { '@id': softwareId },
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImageUrl, width: 1200, height: 630 },
      ...(hasBreadcrumbs ? { breadcrumb: { '@id': breadcrumbId } } : {}),
      ...(ogUpdatedTime ? { dateModified: ogUpdatedTime } : {}),
    },
    ...(hasBreadcrumbs
      ? [{
          '@type': 'BreadcrumbList',
          '@id': breadcrumbId,
          itemListElement: (breadcrumbs ?? []).map((b, idx) => ({
            '@type': 'ListItem',
            position: idx + 1,
            name: b.name,
            item: `${siteUrl}${b.href}`,
          })),
        }]
      : []),
  ],
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={alt} href={`${siteUrl}${altPath}`} />
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:site_name" content="BamDude" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'uk_UA'} />
    <meta property="og:locale:alternate" content={alt === 'en' ? 'en_US' : 'uk_UA'} />
    {ogType === 'article' && ogUpdatedTime && (
      <meta property="article:modified_time" content={ogUpdatedTime} />
    )}
    {ogType === 'article' && ogUpdatedTime && (
      <meta property="og:updated_time" content={ogUpdatedTime} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <slot name="head-jsonld" />

    <!-- Consent Mode v2 default-deny stub. Loaded BEFORE any analytics. -->
    <script is:inline>
      /* eslint-disable prefer-rest-params */
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      /* eslint-enable prefer-rest-params */
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        wait_for_update: 500
      });
    </script>

    <!-- No-flash theme. Reads localStorage → prefers-color-scheme → dark fallback. -->
    <script is:inline>
      /* eslint-disable no-var, @typescript-eslint/no-unused-vars */
      (function () {
        try {
          var stored = localStorage.getItem('theme'); // 'system' | 'light' | 'dark' | null
          var resolved = (!stored || stored === 'system') ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')) : stored;
          if (resolved === 'dark') document.documentElement.classList.add('dark');
        } catch (_err) {
          document.documentElement.classList.add('dark'); // dark fallback on errors
        }
      })();
      /* eslint-enable no-var, @typescript-eslint/no-unused-vars */
    </script>

    <!-- First-visit lang redirect (only on /, only if no preference stored) -->
    <script is:inline define:vars={{ currentLocale: locale }}>
      /* eslint-disable no-var, @typescript-eslint/no-unused-vars */
      (function () {
        if (currentLocale !== 'en') return;
        if (window.location.pathname !== '/') return;
        try {
          if (localStorage.getItem('lang')) return;
          var nav = (navigator.language || 'en').toLowerCase();
          if (nav.indexOf('uk') === 0) {
            localStorage.setItem('lang', 'uk');
            window.location.replace('/uk');
          }
        } catch (_err) { /* noop */ }
      })();
      /* eslint-enable no-var, @typescript-eslint/no-unused-vars */
    </script>
  </head>
  <body class="font-sans bg-bambu-bg text-bambu-text antialiased">
    <slot />
    <CookieBanner client:idle labels={i.cookie} />
    <script is:inline>
      document.addEventListener('click', (e) => {
        const target = e.target;
        if (target instanceof HTMLElement && target.closest('[data-cookie-settings]')) {
          window.dispatchEvent(new Event('cookie:settings'));
        }
      });
    </script>
  </body>
</html>
