---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import Hero from '../components/Hero.astro';
import HighlightBanner from '../components/HighlightBanner.astro';
import FeaturesPreview from '../components/FeaturesPreview.astro';
import HowItWorks from '../components/HowItWorks.astro';
import SupportedPrinters from '../components/SupportedPrinters.astro';
import TechStack from '../components/TechStack.astro';
import HelpWanted from '../components/HelpWanted.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n';
const locale = 'en' as const;
const i = t(locale);
---
<BaseLayout title={i.pages.home.title} description={i.pages.home.description} locale={locale}>
  <ScrollProgress />
  <Nav locale={locale} active="home" />
  <Hero locale={locale} />
  <HighlightBanner locale={locale} />
  <FeaturesPreview locale={locale} />
  <HowItWorks locale={locale} />
  <SupportedPrinters locale={locale} />
  <TechStack locale={locale} />
  <HelpWanted locale={locale} />
  <FinalCTA locale={locale} />
  <Footer locale={locale} />
</BaseLayout>
