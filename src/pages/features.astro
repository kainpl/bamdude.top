---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import PageHeader from '../components/PageHeader.astro';
import FeaturesGrouped from '../components/FeaturesGrouped.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n';
const locale = 'en' as const;
const i = t(locale);
const p = i.pages.features;
---
<BaseLayout title={p.metaTitle} description={p.metaDescription} locale={locale}>
  <ScrollProgress />
  <Nav locale={locale} active="features" />
  <PageHeader eyebrow={p.eyebrow} title={p.title} subtitle={p.subtitle} />
  <FeaturesGrouped locale={locale} />
  <FinalCTA locale={locale} />
  <Footer locale={locale} />
</BaseLayout>
