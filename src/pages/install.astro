---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import PageHeader from '../components/PageHeader.astro';
import InstallSteps from '../components/InstallSteps.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n';
const locale = 'en' as const;
const i = t(locale);
const p = i.pages.install;
---
<BaseLayout title={p.metaTitle} description={p.metaDescription} locale={locale}>
  <ScrollProgress />
  <Nav locale={locale} active="install" />
  <PageHeader eyebrow={p.eyebrow} title={p.title} subtitle={p.subtitle} />
  <InstallSteps locale={locale} />
  <FinalCTA locale={locale} />
  <Footer locale={locale} />
</BaseLayout>
