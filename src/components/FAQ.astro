---
import type { Locale } from '../i18n';
import enFAQ from '../content/en/faq.json';
import ukFAQ from '../content/uk/faq.json';
import { FAQAccordion } from './islands/FAQAccordion';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const data = locale === 'uk' ? ukFAQ : enFAQ;
const items = data.items;
---
<section id="faq" aria-label="FAQ" class="py-16">
  <div class="mx-auto max-w-3xl px-6">
    <FAQAccordion client:visible items={items} />
  </div>
</section>
