---
import type { Locale } from '../i18n';
import { t } from '../i18n';
import { Monitor, ArrowRight } from 'lucide-react';
import Section from './Section.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = t(locale).monitor;
const guide = `https://docs.bamdude.top/${locale === 'uk' ? 'uk/' : ''}features/status-monitor/`;
const screenshot = '/images/status-monitor-printers.png';
---
<Section id="status-monitor" ariaLabel={copy.title}>
  <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
    <div>
      <Monitor size={32} strokeWidth={1.8} className="text-bambu-green mb-5" aria-hidden="true" />
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight leading-tight">{copy.title}</h2>
      <p class="mt-4 text-bambu-text-secondary leading-relaxed">{copy.body}</p>
      <ul class="mt-5 space-y-3 list-disc pl-5 text-sm text-bambu-text-secondary leading-relaxed marker:text-bambu-green">
        {copy.points.map((point) => <li>{point}</li>)}
      </ul>
      <a href={guide} class="mt-6 inline-flex items-center gap-2 font-semibold text-bambu-green-dark dark:text-bambu-green-light underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-bambu-green">
        {copy.cta}<ArrowRight size={18} aria-hidden="true" />
      </a>
      <p class="mt-3 text-sm text-bambu-text-secondary">{copy.availability}</p>
    </div>
    <figure class="min-w-0">
      <a href={screenshot} target="_blank" rel="noopener" class="block rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-bambu-green">
        <img src={screenshot} alt={copy.imageAlt} width="1920" height="1080" loading="lazy" decoding="async" class="w-full h-auto rounded-xl border border-bambu-border" />
      </a>
      <figcaption class="mt-3 text-sm text-bambu-text-secondary">{copy.caption}</figcaption>
    </figure>
  </div>
</Section>
