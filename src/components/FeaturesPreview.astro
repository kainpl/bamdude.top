---
import type { Locale } from '../i18n';
import { t, localePath } from '../i18n';
import Features from './Features.astro';
import { ArrowRight } from 'lucide-react';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const i = t(locale);
---
<section id="features-preview" aria-label="Features preview" class="pt-12 pb-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="text-center max-w-2xl mx-auto">
      <span class="inline-block text-xs uppercase tracking-[0.2em] text-bambu-green font-semibold mb-4">{i.featuresPreview.eyebrow}</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">{i.featuresPreview.title}</h2>
      <p class="mt-4 text-bambu-text-secondary leading-relaxed">{i.featuresPreview.subtitle}</p>
    </div>
    <div class="mt-12">
      <Features locale={locale} />
    </div>
    <div class="mt-12 flex justify-center">
      <a href={localePath(locale, 'features')} class="inline-flex items-center gap-2 rounded-lg px-6 py-3 font-semibold border border-bambu-border bg-bambu-bg-secondary hover:border-bambu-green transition">
        {i.featuresPreview.cta}
        <ArrowRight size={18} strokeWidth={2.5} />
      </a>
    </div>
  </div>
</section>
