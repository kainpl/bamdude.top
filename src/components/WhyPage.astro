---
import type { Locale } from '../i18n';
import { t, localePath } from '../i18n';
import { ArrowRight, Printer, CheckCircle2, AlertTriangle, Server } from 'lucide-react';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const i = t(locale);
const w = i.why;
const docsBase = locale === 'en' ? 'https://docs.bamdude.top' : 'https://docs.bamdude.top/uk';
---

<!-- Two paradigms -->
<section aria-label={w.paradigms.title} class="py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-center max-w-3xl mx-auto">{w.paradigms.title}</h2>
    <div class="mt-12 grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Classic -->
      <div class="rounded-2xl border border-bambu-border bg-bambu-bg-secondary p-6 sm:p-8">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-bambu-bg text-bambu-text-secondary border border-bambu-border">
          <Printer size={14} strokeWidth={2.5} />
          {w.paradigms.classicTitle}
        </div>
        <p class="mt-4 text-bambu-text-secondary leading-relaxed">{w.paradigms.classicLine1}</p>
        <p class="mt-3 text-bambu-text-secondary leading-relaxed">{w.paradigms.classicLine2}</p>
      </div>
      <!-- Fleet -->
      <div class="rounded-2xl border border-bambu-green/40 bg-bambu-bg-secondary p-6 sm:p-8 relative overflow-hidden">
        <div class="absolute -top-16 -right-16 w-48 h-48 rounded-full bg-bambu-green/15 blur-3xl pointer-events-none" aria-hidden="true"></div>
        <div class="relative">
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-bambu-green/15 text-bambu-green border border-bambu-green/30">
            <Server size={14} strokeWidth={2.5} />
            {w.paradigms.fleetTitle}
          </div>
          <p class="mt-4 text-bambu-text-secondary leading-relaxed">{w.paradigms.fleetLine1}</p>
          <ul class="mt-4 space-y-2">
            {w.paradigms.fleetBullets.map((b) => (
              <li class="flex items-start gap-2">
                <CheckCircle2 size={16} strokeWidth={2.5} className="text-bambu-green mt-0.5 shrink-0" />
                <span>{b}</span>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-bambu-text-secondary leading-relaxed">{w.paradigms.fleetLine2}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Example -->
<section aria-label={w.example.title} class="py-20 sm:py-24 bg-bambu-bg-secondary border-y border-bambu-border">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-center">{w.example.title}</h2>
    <p class="mt-4 text-center text-bambu-text-secondary">{w.example.subtitle}</p>
    <div class="mt-10 grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="rounded-2xl border border-bambu-border bg-bambu-bg p-6 sm:p-8">
        <h3 class="font-bold text-lg">{w.example.withoutTitle}</h3>
        <ol class="mt-4 list-decimal list-inside space-y-2 text-bambu-text-secondary leading-relaxed marker:text-bambu-text-secondary marker:font-semibold">
          {w.example.withoutSteps.map((s) => (<li>{s}</li>))}
        </ol>
      </div>
      <div class="rounded-2xl border border-bambu-green/40 bg-bambu-bg p-6 sm:p-8">
        <h3 class="font-bold text-lg text-bambu-green">{w.example.withTitle}</h3>
        <ol class="mt-4 list-decimal list-inside space-y-2 text-bambu-text-secondary leading-relaxed marker:text-bambu-green marker:font-semibold">
          {w.example.withSteps.map((s) => (<li>{s}</li>))}
        </ol>
      </div>
    </div>
    <p class="mt-8 text-center text-bambu-text-secondary max-w-2xl mx-auto">{w.example.afterword}</p>
  </div>
</section>

<!-- Replaces -->
<section aria-label={w.replaces.title} class="py-20 sm:py-24">
  <div class="mx-auto max-w-3xl px-6">
    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">{w.replaces.title}</h2>
    <p class="mt-4 text-bambu-text-secondary leading-relaxed">{w.replaces.intro}</p>
    <ul class="mt-6 space-y-3">
      {w.replaces.items.map((it) => (
        <li class="flex items-start gap-3">
          <CheckCircle2 size={18} strokeWidth={2.5} className="text-bambu-green mt-0.5 shrink-0" />
          <span class="text-bambu-text-secondary leading-relaxed">{it}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Fallback -->
<section aria-label={w.fallback.title} class="py-20 sm:py-24 bg-bambu-bg-secondary border-y border-bambu-border">
  <div class="mx-auto max-w-3xl px-6">
    <div class="flex items-start gap-3">
      <div class="shrink-0 w-10 h-10 rounded-lg bg-amber-500/15 border border-amber-500/40 flex items-center justify-center">
        <AlertTriangle size={20} strokeWidth={2.5} className="text-amber-400" />
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">{w.fallback.title}</h2>
    </div>
    <p class="mt-5 text-bambu-text-secondary leading-relaxed">{w.fallback.body1}</p>
    <p class="mt-4 text-bambu-text-secondary leading-relaxed">{w.fallback.body2}</p>
  </div>
</section>

<!-- Takeaway + CTA -->
<section aria-label={w.takeaway.title} class="py-20 sm:py-28">
  <div class="mx-auto max-w-3xl px-6 text-center">
    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">{w.takeaway.title}</h2>
    <p class="mt-5 text-bambu-text-secondary leading-relaxed">{w.takeaway.intro}</p>
    <blockquote class="mt-6 text-2xl sm:text-3xl font-extrabold text-bambu-green tracking-tight">
      {w.takeaway.blockquote}
    </blockquote>
    <p class="mt-6 text-bambu-text-secondary leading-relaxed">{w.takeaway.body}</p>
    <p class="mt-4 text-bambu-text-secondary leading-relaxed">{w.takeaway.outro}</p>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href={localePath(locale, 'install')}
         class="inline-flex items-center gap-2 rounded-lg px-6 py-3 font-semibold bg-bambu-green text-white shadow-[0_0_32px_rgba(0,174,66,0.5)] hover:bg-bambu-green-light transition">
        {w.ctaPrimary}
        <ArrowRight size={18} strokeWidth={2.5} />
      </a>
      <a href={`${docsBase}/features/virtual-printer/`}
         target="_blank" rel="noopener"
         class="inline-flex items-center gap-2 rounded-lg px-6 py-3 font-semibold border border-bambu-border bg-bambu-bg-secondary hover:border-bambu-green transition">
        {w.ctaSecondary}
      </a>
    </div>
  </div>
</section>
