---
import type { Locale } from '../i18n';
import { t, localePath } from '../i18n';
import { Workflow, ArrowRight } from 'lucide-react';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const i = t(locale);
---
<section aria-label="For the farm" class="pt-16 pb-0">
  <div class="mx-auto max-w-5xl px-6">
    <div class="relative overflow-hidden rounded-3xl border border-bambu-green/40 bg-bambu-bg-secondary p-10 sm:p-14">
      <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-bambu-green/15 blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute -bottom-32 -left-24 w-80 h-80 rounded-full bg-bambu-green/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-bambu-green/15 text-bambu-green border border-bambu-green/30">
          <Workflow size={14} strokeWidth={2.5} />
          {i.highlight.badge}
        </span>
        <h2 class="mt-5 text-2xl sm:text-3xl font-extrabold tracking-tight max-w-2xl">{i.highlight.title}</h2>
        <p class="mt-4 text-bambu-text-secondary leading-relaxed max-w-3xl">{i.highlight.body}</p>
        <a href={localePath(locale, 'features')} class="mt-6 inline-flex items-center gap-2 text-bambu-green font-semibold hover:gap-3 transition-all">
          {i.highlight.cta}
          <ArrowRight size={18} strokeWidth={2.5} />
        </a>
      </div>
    </div>
  </div>
</section>
