---
// Bento mosaic — CSS Grid driven by named grid-areas. Explicit height
// so the grid doesn't collapse if `aspect-ratio` is treated wrong by
// some engine; no 3D wrapper; hover lift stays in 2D. Six tiles by
// default, seventh ("multi-plate library") shows up on ≥1280px.
//
//   ┌─────────────────────┬──────────┬──────────┐
//   │     desktop         │ telegram │  mobile  │
//   │     (2 cols)        │          │          │
//   ├─────────────────────┴──────────┴──────────┤
//   │ stats (2)  │  queue   │  projects         │
//   └────────────┴──────────┴───────────────────┘
---
<div class="hero-mosaic-wrap relative mx-auto mt-16 w-full max-w-6xl hidden sm:block">
  <div class="absolute inset-0 -z-10 blur-3xl opacity-50 bg-[radial-gradient(ellipse_at_center,rgba(0,174,66,0.45)_0%,transparent_70%)]"></div>

  <div class="hero-mosaic">
    <a class="hero-mosaic-tile area-desktop" data-label="Web dashboard" aria-label="Web dashboard screenshot">
      <img src="/images/screenshot-desktop.png" alt="BamDude web dashboard" loading="eager" fetchpriority="high" />
    </a>
    <a class="hero-mosaic-tile area-telegram is-portrait" data-label="Telegram bot" aria-label="Telegram bot screenshot">
      <img src="/images/screenshot-telegram.png" alt="BamDude Telegram bot" loading="lazy" />
    </a>
    <a class="hero-mosaic-tile area-mobile is-portrait" data-label="On mobile" aria-label="Mobile screenshot">
      <img src="/images/screenshot-mobile.png" alt="BamDude on mobile" loading="lazy" />
    </a>
    <a class="hero-mosaic-tile area-stats" data-label="Statistics" aria-label="Statistics screenshot">
      <img src="/images/screenshot-statistics.png" alt="BamDude statistics" loading="lazy" />
    </a>
    <a class="hero-mosaic-tile area-queue" data-label="Print queue" aria-label="Print queue screenshot">
      <img src="/images/screenshot-queue.png" alt="BamDude print queue" loading="lazy" />
    </a>
    <a class="hero-mosaic-tile area-projects" data-label="Projects" aria-label="Projects screenshot">
      <img src="/images/screenshot-projects.png" alt="BamDude projects" loading="lazy" />
    </a>
    <a class="hero-mosaic-tile area-files" data-label="Multi-plate library" aria-label="Multi-plate library screenshot">
      <img src="/images/screenshot-files-mp.png" alt="BamDude multi-plate library" loading="lazy" />
    </a>
  </div>
</div>

<style>
  .hero-mosaic {
    display: grid;
    width: 100%;
    /* Explicit height — keeps the grid sane without depending on
       aspect-ratio + grid template interaction. */
    min-height: 460px;
    height: clamp(420px, 46vw, 560px);
    grid-template-columns: 1.6fr 1fr 1fr;
    grid-template-rows: 2fr 1fr;
    grid-template-areas:
      "desktop telegram mobile"
      "stats   queue    projects";
    gap: 0.75rem;
  }

  /* Wider viewports: surface the multi-plate library tile. */
  @media (min-width: 1280px) {
    .hero-mosaic {
      grid-template-columns: 1.7fr 0.9fr 0.9fr 0.9fr;
      grid-template-areas:
        "desktop  telegram mobile  files"
        "stats    stats    queue   projects";
    }
    .area-files { display: block; }
  }

  /* Default: hide the bonus tile until we have a 4-col grid. */
  .area-files { display: none; }

  .area-desktop  { grid-area: desktop; }
  .area-telegram { grid-area: telegram; }
  .area-mobile   { grid-area: mobile; }
  .area-stats    { grid-area: stats; }
  .area-queue    { grid-area: queue; }
  .area-projects { grid-area: projects; }

  .hero-mosaic-tile {
    position: relative;
    display: block;
    border-radius: 0.85rem;
    overflow: hidden;
    border: 1px solid var(--border-color);
    background: var(--bg-secondary);
    box-shadow:
      0 30px 60px -20px rgba(0, 0, 0, 0.55),
      0 12px 24px -12px rgba(0, 174, 66, 0.18);
    transition:
      transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 280ms ease,
      border-color 280ms ease;
    will-change: transform;
    cursor: pointer;
    text-decoration: none;
  }

  .hero-mosaic-tile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  /* Top-anchored crop for portrait tiles so the chrome stays visible. */
  .is-portrait img { object-position: top center; }

  /* Bottom dark gradient for label legibility. */
  .hero-mosaic-tile::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, transparent 55%, rgba(0, 0, 0, 0.55) 100%);
    opacity: 0.55;
    transition: opacity 280ms ease;
  }
  .hero-mosaic-tile:hover::before { opacity: 0.85; }

  /* Floating label pill — bottom-left, fades in on hover. */
  .hero-mosaic-tile::after {
    content: attr(data-label);
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.72);
    border: 1px solid rgba(0, 174, 66, 0.5);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 240ms ease, transform 240ms ease;
    pointer-events: none;
  }
  .hero-mosaic-tile:hover::after {
    opacity: 1;
    transform: translateY(0);
  }

  /* Hover lift — 2D translate + scale, no 3D so nothing collapses. */
  .hero-mosaic-tile:hover {
    transform: translateY(-4px) scale(1.012);
    border-color: rgba(0, 174, 66, 0.55);
    box-shadow:
      0 40px 90px -20px rgba(0, 0, 0, 0.65),
      0 16px 32px -10px rgba(0, 174, 66, 0.45);
    z-index: 5;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-mosaic-tile {
      transition: none;
    }
    .hero-mosaic-tile:hover {
      transform: none;
    }
  }
</style>
