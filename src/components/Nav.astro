---
import type { Locale } from '../i18n';
import { t, localePath } from '../i18n';
import { ThemeToggle } from './islands/ThemeToggle';
import { LangToggle } from './islands/LangToggle';

type Active = 'home' | 'why' | 'features' | 'compare' | 'install' | 'faq';
interface Props { locale: Locale; active?: Active; }
const { locale, active = 'home' } = Astro.props;
const i = t(locale);
const repo = import.meta.env.PUBLIC_GITHUB_REPO || 'https://github.com/kainpl/bamdude';
const docs = 'https://docs.bamdude.top';

const items: { id: Active; href: string; label: string }[] = [
  { id: 'why',      href: localePath(locale, 'why'),      label: i.nav.why },
  { id: 'features', href: localePath(locale, 'features'), label: i.nav.features },
  { id: 'compare',  href: localePath(locale, 'compare'),  label: i.nav.compare },
  { id: 'install',  href: localePath(locale, 'install'),  label: i.nav.install },
  { id: 'faq',      href: localePath(locale, 'faq'),      label: i.nav.faq },
];

// Section anchors on the home page (the "frames"). From any other page the
// link navigates home first — the anchor survives the trip, and the global
// smooth-scroll + each section's scroll-mt handle the landing.
const anchors: { href: string; label: string }[] = [
  { href: `${localePath(locale)}#partners`, label: i.nav.partners },
];
---
<header class="sticky top-0 z-40 backdrop-blur bg-bambu-bg/80 border-b border-bambu-border">
  <nav class="mx-auto max-w-6xl px-6 h-16 flex items-center justify-between">
    <a href={localePath(locale)} class={`flex items-center gap-2 font-extrabold text-lg tracking-tight transition ${active === 'home' ? 'text-bambu-green' : 'hover:text-bambu-green'}`}>
      <img src="/images/logo-icon.png" alt="BamDude" class="h-8 w-auto" width="32" height="32" />
      <span>BamDude</span>
    </a>
    <div class="hidden md:flex items-center gap-6 text-sm">
      {items.map((it) => (
        <a href={it.href}
           class={`transition ${active === it.id ? 'text-bambu-green font-semibold' : 'hover:text-bambu-green'}`}
           aria-current={active === it.id ? 'page' : undefined}>
          {it.label}
        </a>
      ))}
      {anchors.map((a) => (
        <a href={a.href} class="hover:text-bambu-green transition">{a.label}</a>
      ))}
      <a href={docs} class="hover:text-bambu-green transition" target="_blank" rel="noopener">{i.nav.docs}</a>
      <a href={repo} class="hover:text-bambu-green transition" target="_blank" rel="noopener">{i.nav.github}</a>
    </div>
    <div class="flex items-center gap-2" data-toggles>
      <LangToggle client:load currentLocale={locale} labelLang={i.lang.label} labelEn={i.lang.en} labelUk={i.lang.uk} />
      <ThemeToggle client:load labels={i.theme} />
      <slot name="toggles" />
    </div>
  </nav>
</header>
