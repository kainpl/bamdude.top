# BamDude bug-report relay — runtime config.
#
# Copy to /etc/bamdude-relay.env and `chmod 600` so only the systemd unit's
# user can read it. The systemd unit (deploy/relay.service) is wired with
# `EnvironmentFile=/etc/bamdude-relay.env` — keep this path in sync.

# REQUIRED — PAT with `issues:write` scope on GITHUB_REPO.
# Use a fine-grained token: Settings → Developer settings → Personal access
# tokens → Fine-grained tokens. Resource owner: kainpl. Repository access:
# only kainpl/bamdude. Permissions: `Issues: Read and write`. Expires: 1 year.
GITHUB_PAT=ghp_replace_me

# Target repo. Default is `kainpl/bamdude`.
GITHUB_REPO=kainpl/bamdude

# Listen address. Bind to localhost — nginx terminates TLS and proxies in
# from /api/bug-report. The public Cloudflare-proxied URL never exposes the
# relay directly.
HOST=127.0.0.1
PORT=3001

# Where uploaded screenshots are written. nginx must serve this directory at
# SCREENSHOT_PUBLIC_BASE — see deploy/nginx.conf.
#
# Lives inside the relay install dir so the whole relay (code + state) is
# under one tree. The deploy workflow's rsync excludes this path so
# screenshots survive every deploy; full reinstall (rm -rf /opt/bamdude-relay)
# wipes them — old issue-body image links go 404 but the issues themselves
# stay intact.
SCREENSHOT_DIR=/opt/bamdude-relay/screenshots
SCREENSHOT_PUBLIC_BASE=https://bamdude.top/bug-attachments

# Optional CORS allow-list. Empty = allow any origin (which fits the deployment
# model — every BamDude install runs on a different LAN/VPN URL, so origin is
# not a useful auth signal). Comma-separated.
# ALLOWED_ORIGINS=https://bamdude.top

# Hard caps. Body limit is JSON payload (description + base64 screenshot +
# support_info). 1920×1080 JPEG q=0.7 ≈ 300 KB → 12 MB is comfortable.
MAX_BODY_BYTES=12582912

# Edge rate limit per IP. Mirrors BamDude's client-side limit (5/hour) but
# slightly looser to absorb retries. CGNAT customers share an IP — if you
# operate in a high-NAT region, raise this.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MIN=60

LOG_LEVEL=info
